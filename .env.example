# Knowledge Lab · Environment Configuration
# Copy this file to .env and fill in your keys

# Required: LLM API Key (choose one provider)
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here

# Alternative providers (set LLM_PROVIDER and fill corresponding key)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=xxx
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# Vault path (default: ./vault)
VAULT_PATH=./vault

# Optional: PostgreSQL for quiz stats persistence
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=n8n
# PG_USER=n8n
# PG_PASSWORD=
