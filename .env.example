# Knowledge Lab · Environment Configuration
# Copy this file to .env and fill in your keys

# === LLM API Key (required) ===
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here

# Alternative providers (set LLM_PROVIDER and fill corresponding key)
# LLM_PROVIDER=openai    → OPENAI_API_KEY=sk-xxx
# LLM_PROVIDER=zhipu     → ZHIPU_API_KEY=xxx
# LLM_PROVIDER=ollama    → OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════════════
# === Vault Storage Mode (choose one) ===
# ═══════════════════════════════════════════════
#
# Mode 1: Standalone (default) — notes stored in project's own vault/ directory
#         No external dependency. Works out of the box.
VAULT_PATH=./vault
#
# Mode 2: Obsidian-linked — notes stored in your Obsidian Vault
#         Knowledge Lab + Obsidian read/write the SAME files.
#         Uncomment the line below and set your Obsidian vault path:
# VAULT_PATH=C:/Users/YourName/Documents/My Obsidian Vault
#
# Mode 3: Custom path — any folder on your disk
# VAULT_PATH=/path/to/your/notes

# === Optional: PostgreSQL for quiz stats persistence ===
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=n8n
# PG_USER=n8n
# PG_PASSWORD=
