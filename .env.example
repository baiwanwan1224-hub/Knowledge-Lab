# Knowledge Lab · Environment Configuration
# Copy this file to .env and fill in your keys

# === LLM API Key (required) ===
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here

# === OCR 多模态 API Key（可选，不填则截图录入功能不可用）===
# 出题和批改只需要文本 API（上面 DeepSeek 即可）。
# 截图 OCR 需要多模态模型（支持图片理解的 LLM），在此填入对应 API Key。
# 没有多模态 Key 不影响核心出题/批改/知识库功能。
MINIMAX_API_KEY=

# Alternative providers (set LLM_PROVIDER and fill corresponding key)
# LLM_PROVIDER=openai    → OPENAI_API_KEY=sk-xxx
# LLM_PROVIDER=zhipu     → ZHIPU_API_KEY=xxx
# LLM_PROVIDER=ollama    → OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════════════
# === RAG 检索核心（可选）===
# ═══════════════════════════════════════════════
# 用智谱 embedding-3 做语义检索。构建索引:
#   PYTHONIOENCODING=utf-8 python -m server.rag_index build
# 检索演示:
#   PYTHONIOENCODING=utf-8 python -m server.rag_index retrieve --query "你的问题"
# 评测(Recall@k/MRR 三路对比):
#   PYTHONIOENCODING=utf-8 python scripts/rag_eval.py
# ZHIPU_API_KEY=your-zhipu-key-here     # 需有余额，embedding-3 按量计费
# ZHIPU_EMBEDDING_MODEL=embedding-3
# RAG_MAX_CHARS=1500    # 分块字符预算（≈512 token 兜底）
# RAG_OVERLAP=200       # 超长段落切分重叠
# RAG_RETRIEVAL=1       # 设为 1 时 quiz_generator 出题启用语义检索补充（默认关闭）

# ═══════════════════════════════════════════════
# === 学习记忆（可选 · 8/5 集成）===
# ═══════════════════════════════════════════════
# 基于 memory_core 的学习者长期记忆闭环：
#   - 写侧：quiz_grader 批改后把答题表现（知识点/对错/薄弱点）压缩成
#           data/memory_store.json 的学习者记忆（过忠实度门禁，防幻觉入库）
#   - 读侧：quiz_generator 出题时注入学习者记忆，侧重薄弱点出题
# MEMORY_ENABLE=1          # 设为 1 时启用记忆闭环（默认关闭）
# 记忆压缩主模型用 LLM_MODEL（DeepSeek），忠实度校验用 FAITHFULNESS_MODEL（glm-4-flash）
# 记忆写入失败不影响批改/出题主流程（记忆只是增强）

# ═══════════════════════════════════════════════
# === 双模型批改校准（8/5 落地）===
# ═══════════════════════════════════════════════
# scripts/model_calibration.py 用第二个独立模型交叉评分 golden_set，偏差>1 分触发审查。
# 默认第二模型=智谱 GLM-4-flash（用 ZHIPU_API_KEY）。标准§五指定 GPT-4.1——
# 配好下面三个变量即可切换（需自备 GPT key）：
# MODEL_B_API_KEY=your-gpt-key
# MODEL_B_API_URL=https://api.openai.com/v1/chat/completions
# MODEL_B_MODEL=gpt-4.1

# ═══════════════════════════════════════════════
# === Vault Storage Mode (choose one) ===
# ═══════════════════════════════════════════════
#
# Mode 1: Standalone (default) — notes stored in project's own vault/ directory
#         No external dependency. Works out of the box.
VAULT_PATH=./vault
#
# Mode 2: Obsidian-linked — notes stored in your Obsidian Vault
#         Knowledge Lab + Obsidian read/write the SAME files.
#         Uncomment the line below and set your Obsidian vault path:
# VAULT_PATH=C:/Users/YourName/Documents/My Obsidian Vault
#
# Mode 3: Custom path — any folder on your disk
# VAULT_PATH=/path/to/your/notes

# === API Authentication (optional) ===
# Leave empty for local dev mode (no auth required).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# === Optional: PostgreSQL for quiz stats persistence ===
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=n8n
# PG_USER=n8n
# PG_PASSWORD=
